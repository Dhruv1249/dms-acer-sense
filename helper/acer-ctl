#!/bin/sh
# Privileged helper for the Acer Sense Dux Shell plugin.
# Root-owned, allowed via NOPASSWD.
# All value validation happens strictly here via whitelists.
set -eu

PROFILE_SYS=/sys/firmware/acpi/platform_profile

NS=""
for d in /sys/devices/platform/acer-wmi/nitro_sense \
         /sys/devices/platform/acer-wmi/predator_sense \
         /sys/module/linuwu_sense/drivers/platform:acer-wmi/acer-wmi/nitro_sense \
         /sys/module/linuwu_sense/drivers/platform:acer-wmi/acer-wmi/predator_sense; do
    if [ -d "$d" ]; then
        NS="$d"
        break
    fi
done

RGB_DIR=""
for d in /sys/devices/platform/acer-wmi/four_zoned_kb \
         /sys/module/linuwu_sense/drivers/platform:acer-wmi/acer-wmi/four_zoned_kb; do
    if [ -d "$d" ]; then
        RGB_DIR="$d"
        break
    fi
done

TURBO_DIR=""
for d in /sys/devices/platform/acer-wmi/turbo_sense \
         /sys/module/linuwu_sense/drivers/platform:acer-wmi/acer-wmi/turbo_sense; do
    if [ -d "$d" ]; then
        TURBO_DIR="$d"
        break
    fi
done

need_ns() {
    [ -n "$NS" ] || { echo "Error: linuwu-sense not found (nitro_sense/predator_sense sysfs node missing)" >&2; exit 1; }
}

need_rgb() {
    [ -n "$RGB_DIR" ] || { echo "Error: four_zoned_kb sysfs node not found" >&2; exit 1; }
}

action="${1:-}"
shift 2>/dev/null || true

case "$action" in
    ping|check)
        echo "ok"
        exit 0
        ;;
    profile)
        val="${1:-}"
        case "$val" in
            low-power|quiet|cool|balanced|balanced-performance|performance|turbo)
                printf '%s' "$val" > "$PROFILE_SYS" ;;
            *) echo "Error: profile must be low-power|quiet|cool|balanced|balanced-performance|performance|turbo" >&2; exit 1 ;;
        esac
        ;;
    fan)
        need_ns
        val="${1:-}"
        case "$val" in
            auto)  printf '%s' "0,0"     > "$NS/fan_speed" ;;
            max)   printf '%s' "100,100" > "$NS/fan_speed" ;;
            quiet) printf '%s' "40,40"   > "$NS/fan_speed" ;;
            *)
                # Match single value (0-100) or dual values (0-100,0-100)
                if echo "$val" | grep -Eq '^([0-9]|[1-9][0-9]|100)$'; then
                    printf '%s' "$val,$val" > "$NS/fan_speed"
                elif echo "$val" | grep -Eq '^([0-9]|[1-9][0-9]|100),([0-9]|[1-9][0-9]|100)$'; then
                    printf '%s' "$val" > "$NS/fan_speed"
                else
                    echo "Error: fan value must be auto|quiet|max|<0-100>|<0-100,0-100>" >&2
                    exit 1
                fi
                ;;
        esac
        ;;
    battery-limit)
        need_ns
        val="${1:-}"
        case "$val" in
            on|1)  printf '%s' "1" > "$NS/battery_limiter" ;;
            off|0) printf '%s' "0" > "$NS/battery_limiter" ;;
            *) echo "Error: battery-limit must be on|off" >&2; exit 1 ;;
        esac
        ;;
    battery-calibration)
        need_ns
        val="${1:-}"
        case "$val" in
            start|on|1) printf '%s' "1" > "$NS/battery_calibration" ;;
            stop|off|0) printf '%s' "0" > "$NS/battery_calibration" ;;
            *) echo "Error: battery-calibration must be start|stop" >&2; exit 1 ;;
        esac
        ;;
    usb-charging)
        need_ns
        val="${1:-}"
        case "$val" in
            off|0)    printf '%s' "0"    > "$NS/usb_charging" ;;
            10|20|30) printf '%s' "$val" > "$NS/usb_charging" ;;
            *) echo "Error: usb-charging must be off|10|20|30" >&2; exit 1 ;;
        esac
        ;;
    backlight-timeout)
        need_ns
        val="${1:-}"
        case "$val" in
            on|1)  printf '%s' "1" > "$NS/backlight_timeout" ;;
            off|0) printf '%s' "0" > "$NS/backlight_timeout" ;;
            *) echo "Error: backlight-timeout must be on|off" >&2; exit 1 ;;
        esac
        ;;
    boot-sound)
        need_ns
        val="${1:-}"
        case "$val" in
            on|1)  printf '%s' "1" > "$NS/boot_animation_sound" ;;
            off|0) printf '%s' "0" > "$NS/boot_animation_sound" ;;
            *) echo "Error: boot-sound must be on|off" >&2; exit 1 ;;
        esac
        ;;
    lcd-override)
        need_ns
        val="${1:-}"
        case "$val" in
            on|1)  printf '%s' "1" > "$NS/lcd_override" ;;
            off|0) printf '%s' "0" > "$NS/lcd_override" ;;
            *) echo "Error: lcd-override must be on|off" >&2; exit 1 ;;
        esac
        ;;
    rgb-effect)
        need_rgb
        if [ "$#" -ge 7 ]; then
            val="$1,$2,$3,$4,$5,$6,$7"
        else
            val="${1:-}"
        fi
        c255="([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])"
        c100="([0-9]|[1-9][0-9]|100)"
        pattern="^[0-7],[0-9],$c100,[0-2],$c255,$c255,$c255$"
        if echo "$val" | grep -Eq "$pattern"; then
            printf '%s' "$val" > "$RGB_DIR/four_zone_mode"
        else
            echo "Error: rgb-effect requires 'mode(0-7),speed(0-9),brightness(0-100),direction(0-2),r(0-255),g(0-255),b(0-255)'" >&2
            exit 1
        fi
        ;;
    rgb-zones)
        need_rgb
        if [ "$#" -ge 5 ]; then
            val="$1,$2,$3,$4,$5"
        else
            val="${1:-}"
        fi
        c100="([0-9]|[1-9][0-9]|100)"
        chex="[0-9a-fA-F]{6}"
        pattern="^$chex,$chex,$chex,$chex,$c100$"
        if echo "$val" | grep -Eq "$pattern"; then
            printf '%s' "$val" > "$RGB_DIR/per_zone_mode"
        else
            echo "Error: rgb-zones requires 'hex1,hex2,hex3,hex4,brightness(0-100)' (e.g. ff0000,00ff00,0000ff,ffffff,100)" >&2
            exit 1
        fi
        ;;
    turbo)
        val="${1:-}"
        if [ -n "$TURBO_DIR" ] && [ -w "$TURBO_DIR/turbo_state" ]; then
            case "$val" in
                on|1)  printf '%s' "1" > "$TURBO_DIR/turbo_state" ;;
                off|0) printf '%s' "0" > "$TURBO_DIR/turbo_state" ;;
                *) echo "Error: turbo must be on|off" >&2; exit 1 ;;
            esac
        else
            echo "Error: turbo_sense sysfs not writable or not supported on this model" >&2
            exit 1
        fi
        ;;
    gpu)
        val="${1:-}"
        case "$val" in
            hybrid|integrated|nvidia)
                command -v envycontrol >/dev/null 2>&1 || { echo "Error: envycontrol not found" >&2; exit 1; }
                envycontrol -s "$val" ;;
            *) echo "Error: gpu mode must be hybrid|integrated|nvidia" >&2; exit 1 ;;
        esac
        ;;
    *)
        echo "Usage: acer-ctl {ping|profile|fan|battery-limit|battery-calibration|usb-charging|backlight-timeout|boot-sound|lcd-override|rgb-effect|rgb-zones|gpu} <value>" >&2
        exit 1
        ;;
esac
