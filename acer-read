#!/bin/sh
# Telemetry reader (unprivileged) for the Acer Sense Dux Shell plugin.
# Usage: acer-read [sysfs|gpu|pill]
#   sysfs  -> profile, CPU temp, fans, limiter, usb_charging,
#             backlight_timeout, battery_calibration, boot_animation_sound,
#             lcd_override, four_zone_mode, per_zone_mode, turbo_state,
#             helper check, etc.
#   gpu    -> nvidia-smi (temp/power/util) + envycontrol --query (caches static lspci)
#   pill   -> fast lightweight CPU temp + fan RPM read for bar pill
# Output: single-line JSON for JSON.parse in QML.
set -eu

mode="${1:-sysfs}"
read_raw() { cat "$1" 2>/dev/null || true; }

hwmon_by_name() {
    for d in /sys/class/hwmon/hwmon*; do
        [ -r "$d/name" ] || continue
        if [ "$(cat "$d/name" 2>/dev/null)" = "$1" ]; then
            printf '%s' "$d"
            return 0
        fi
    done
    return 1
}

# Fast lightweight pill read
if [ "$mode" = "pill" ]; then
    cpuTemp=""
    core=$(hwmon_by_name coretemp || true)
    if [ -n "$core" ]; then
        raw=$(read_raw "$core/temp1_input")
        [ -n "$raw" ] && cpuTemp=$((raw / 1000))
    fi
    if [ -z "$cpuTemp" ]; then
        amd=$(hwmon_by_name k10temp || hwmon_by_name zenpower || true)
        if [ -n "$amd" ]; then
            raw=$(read_raw "$amd/temp1_input")
            [ -n "$raw" ] && cpuTemp=$((raw / 1000))
        fi
    fi
    fanCpu=""
    acer=$(hwmon_by_name acer || true)
    if [ -n "$acer" ]; then
        fanCpu=$(read_raw "$acer/fan1_input")
    fi
    printf '{"cpuTemp":%s,"fanCpu":%s}\n' "${cpuTemp:-null}" "${fanCpu:-null}"
    exit 0
fi

jnum() { if [ -n "${2:-}" ]; then printf '"%s":%s' "$1" "$2"; else printf '"%s":null' "$1"; fi; }
jstr() { if [ -n "${2:-}" ]; then printf '"%s":"%s"' "$1" "$2"; else printf '"%s":null' "$1"; fi; }
jbool() { if [ "${2:-}" = "true" ] || [ "${2:-}" = "1" ]; then printf '"%s":true' "$1"; else printf '"%s":false' "$1"; fi; }

if [ "$mode" = "gpu" ]; then
    runtime_dir="${XDG_RUNTIME_DIR:-}"
    gpu_cache=""
    if [ -n "$runtime_dir" ] && [ -d "$runtime_dir" ] && [ -w "$runtime_dir" ]; then
        gpu_cache="$runtime_dir/.acer_gpu_static"
    fi

    hasIgpu="false"
    hasDgpu="false"
    hardwareMux="dynamic"
    igpuName=""
    dgpuName=""
    hasEnvyControl="false"
    envyCmd="sudo pip install envycontrol"

    if [ -n "$gpu_cache" ] && [ -f "$gpu_cache" ]; then
        while IFS='=' read -r key val || [ -n "$key" ]; do
            # Strip surrounding quotes if present
            val="${val%\"}"
            val="${val#\"}"
            case "$key" in
                hasIgpu) hasIgpu="$val" ;;
                hasDgpu) hasDgpu="$val" ;;
                hardwareMux) hardwareMux="$val" ;;
                igpuName) igpuName="$val" ;;
                dgpuName) dgpuName="$val" ;;
                hasEnvyControl) hasEnvyControl="$val" ;;
                envyCmd) envyCmd="$val" ;;
            esac
        done < "$gpu_cache"
    else
        if command -v envycontrol >/dev/null 2>&1; then
            hasEnvyControl="true"
        fi

        lspci_out=$(lspci 2>/dev/null || true)
        vga_lines=$(printf '%s\n' "$lspci_out" | grep -iE 'VGA compatible controller|Display controller|3D controller' || true)

        if printf '%s\n' "$vga_lines" | grep -qE '\b(Intel|ATI|AMD|Radeon)\b'; then
            hasIgpu="true"
            igpuName=$(printf '%s\n' "$vga_lines" | grep -E '\b(Intel|ATI|AMD|Radeon)\b' | head -1 | sed -E 's/^[0-9a-fA-F:.]* [^:]*: //')
        fi

        if printf '%s\n' "$vga_lines" | grep -qi 'NVIDIA'; then
            hasDgpu="true"
            dgpuName=$(printf '%s\n' "$vga_lines" | grep -i 'NVIDIA' | head -1 | sed -E 's/^[0-9a-fA-F:.]* [^:]*: //')
        fi

        if [ "$hasDgpu" = "true" ] && [ "$hasIgpu" = "false" ]; then
            hardwareMux="discrete"
        elif [ "$hasIgpu" = "true" ] && [ "$hasDgpu" = "false" ]; then
            hardwareMux="integrated"
        fi

        if [ -f /etc/os-release ]; then
            . /etc/os-release 2>/dev/null || true
        fi
        os_id="${ID:-}"
        os_like="${ID_LIKE:-}"
        case "$os_id $os_like" in
            *arch*|*cachyos*|*manjaro*|*endeavouros*)
                if command -v yay >/dev/null 2>&1; then
                    envyCmd="yay -S envycontrol"
                elif command -v paru >/dev/null 2>&1; then
                    envyCmd="paru -S envycontrol"
                else
                    envyCmd="yay -S envycontrol"
                fi
                ;;
            *fedora*|*nobara*|*rhel*|*centos*)
                envyCmd="sudo dnf copr enable sunwire/envycontrol && sudo dnf install python3-envycontrol"
                ;;
            *debian*|*ubuntu*|*pop*|*mint*)
                if command -v pipx >/dev/null 2>&1; then
                    envyCmd="sudo pipx install envycontrol"
                else
                    envyCmd="sudo pip install --break-system-packages envycontrol"
                fi
                ;;
            *opensuse*|*suse*)
                envyCmd="sudo zypper in python3-envycontrol || sudo pip install envycontrol"
                ;;
        esac

        # Save to cache if runtime dir is available
        if [ -n "$gpu_cache" ]; then
            cat <<EOF > "$gpu_cache" 2>/dev/null || true
hasIgpu="$hasIgpu"
hasDgpu="$hasDgpu"
hardwareMux="$hardwareMux"
igpuName="$igpuName"
dgpuName="$dgpuName"
hasEnvyControl="$hasEnvyControl"
envyCmd="$envyCmd"
EOF
        fi
    fi

    gtemp=""; gpow=""; gutil=""; gmode=""
    hasEnvyControl="false"
    if command -v envycontrol >/dev/null 2>&1; then
        hasEnvyControl="true"
        gmode=$(envycontrol --query 2>/dev/null | tr -d '[:space:]' || true)
    fi
    if [ "$hardwareMux" = "discrete" ]; then
        gmode="discrete"
    elif [ "$hardwareMux" = "integrated" ]; then
        [ -z "$gmode" ] && gmode="integrated"
    fi

    # Only query nvidia-smi if dGPU is present and not forced off in integrated mode
    if [ "$hasDgpu" = "true" ] && [ "$gmode" != "integrated" ] && command -v nvidia-smi >/dev/null 2>&1; then
        line=$(nvidia-smi --query-gpu=temperature.gpu,power.draw,utilization.gpu \
                --format=csv,noheader,nounits 2>/dev/null | head -1 || true)
        if [ -n "$line" ]; then
            gtemp=$(printf '%s' "$line" | awk -F',' '{gsub(/[^0-9.]/,"",$1); print $1}')
            gpow=$(printf '%s' "$line"  | awk -F',' '{gsub(/[^0-9.]/,"",$2); print $2}')
            gutil=$(printf '%s' "$line" | awk -F',' '{gsub(/[^0-9.]/,"",$3); print $3}')
        fi
    fi

    printf '{'
    jbool hasEnvyControl "$hasEnvyControl"; printf ','
    jbool hasIgpu "$hasIgpu"; printf ','
    jbool hasDgpu "$hasDgpu"; printf ','
    jstr hardwareMux "$hardwareMux"; printf ','
    jstr igpuName "$igpuName"; printf ','
    jstr dgpuName "$dgpuName"; printf ','
    jnum gpuTemp "$gtemp"; printf ','
    jnum gpuPower "$gpow"; printf ','
    jnum gpuUtil "$gutil"; printf ','
    jstr gpuMode "$gmode"; printf ','
    jstr envyInstallCmd "$envyCmd"
    printf '}\n'
    exit 0
fi

# Locate linuwu-sense predator_sense or nitro_sense directory
NS=""
for d in /sys/devices/platform/acer-wmi/nitro_sense \
         /sys/devices/platform/acer-wmi/predator_sense \
         /sys/module/linuwu_sense/drivers/platform:acer-wmi/acer-wmi/nitro_sense \
         /sys/module/linuwu_sense/drivers/platform:acer-wmi/acer-wmi/predator_sense; do
    if [ -d "$d" ]; then
        NS="$d"
        break
    fi
done

# Locate RGB directory (four_zoned_kb)
RGB_DIR=""
for d in /sys/devices/platform/acer-wmi/four_zoned_kb \
         /sys/module/linuwu_sense/drivers/platform:acer-wmi/acer-wmi/four_zoned_kb; do
    if [ -d "$d" ]; then
        RGB_DIR="$d"
        break
    fi
done

# Locate Turbo directory (turbo_sense)
TURBO_DIR=""
for d in /sys/devices/platform/acer-wmi/turbo_sense \
         /sys/module/linuwu_sense/drivers/platform:acer-wmi/acer-wmi/turbo_sense; do
    if [ -d "$d" ]; then
        TURBO_DIR="$d"
        break
    fi
done

# Platform profile
profile=$(read_raw /sys/firmware/acpi/platform_profile)
profileChoices=$(read_raw /sys/firmware/acpi/platform_profile_choices)

# Fans and CPU Temperature
acer=$(hwmon_by_name acer || true)
fanCpu=""; fanGpu=""; fanHwmonPath=""
if [ -n "$acer" ]; then
    fanCpu=$(read_raw "$acer/fan1_input")
    fanGpu=$(read_raw "$acer/fan2_input")
    [ -r "$acer/fan1_input" ] && fanHwmonPath="$acer/fan1_input"
fi

cpuTemp=""
# Intel coretemp
core=$(hwmon_by_name coretemp || true)
if [ -n "$core" ]; then
    raw=$(read_raw "$core/temp1_input")
    [ -n "$raw" ] && cpuTemp=$((raw / 1000))
fi
# Fallback to AMD k10temp / zenpower if Intel coretemp not present
if [ -z "$cpuTemp" ]; then
    amd=$(hwmon_by_name k10temp || hwmon_by_name zenpower || true)
    if [ -n "$amd" ]; then
        raw=$(read_raw "$amd/temp1_input")
        [ -n "$raw" ] && cpuTemp=$((raw / 1000))
    fi
fi
# Fallback to thermal zone x86_pkg_temp / acpitz
if [ -z "$cpuTemp" ]; then
    for tz in /sys/class/thermal/thermal_zone*; do
        [ -r "$tz/type" ] || continue
        tz_type=$(cat "$tz/type" 2>/dev/null || true)
        if [ "$tz_type" = "x86_pkg_temp" ] || [ "$tz_type" = "acpitz" ]; then
            raw=$(read_raw "$tz/temp")
            [ -n "$raw" ] && [ "$raw" -gt 0 ] && cpuTemp=$((raw / 1000)) && break
        fi
    done
fi

# Linuwu-Sense core nodes
battLimiter=""; usbCharging=""; fanSpeed=""
backlightTimeout=""; batteryCalibration=""; bootAnimationSound=""; lcdOverride=""
if [ -n "$NS" ]; then
    battLimiter=$(read_raw "$NS/battery_limiter")
    usbCharging=$(read_raw "$NS/usb_charging")
    fanSpeed=$(read_raw "$NS/fan_speed")
    backlightTimeout=$(read_raw "$NS/backlight_timeout")
    batteryCalibration=$(read_raw "$NS/battery_calibration")
    bootAnimationSound=$(read_raw "$NS/boot_animation_sound")
    lcdOverride=$(read_raw "$NS/lcd_override")
fi

# RGB keyboard nodes
fourZoneMode=""; perZoneMode=""
hasRgb="false"
if [ -n "$RGB_DIR" ]; then
    hasRgb="true"
    fourZoneMode=$(read_raw "$RGB_DIR/four_zone_mode")
    perZoneMode=$(read_raw "$RGB_DIR/per_zone_mode")
fi

# ENEK5130 2025+ keyboard controller detection
hasEnek5130="false"
if grep -qls "ENEK5130" /sys/class/hidraw/*/device/uevent 2>/dev/null; then
    hasEnek5130="true"
fi

# Turbo node
turboState=""
hasTurbo="false"
if [ -n "$TURBO_DIR" ] && [ -r "$TURBO_DIR/turbo_state" ]; then
    hasTurbo="true"
    turboState=$(read_raw "$TURBO_DIR/turbo_state")
fi

# Privileged helper detection (cached in $XDG_RUNTIME_DIR to prevent auth log spam)
hasHelper="false"
helperInstalled="false"
runtime_dir="${XDG_RUNTIME_DIR:-}"
cache=""
if [ -n "$runtime_dir" ] && [ -d "$runtime_dir" ] && [ -w "$runtime_dir" ]; then
    cache="$runtime_dir/.acer_helper_ok"
fi
if [ -n "$cache" ] && [ -f "$cache" ]; then
    hasHelper="true"
    helperInstalled="true"
elif [ -x "/usr/local/bin/acer-ctl" ]; then
    helperInstalled="true"
    if sudo -n /usr/local/bin/acer-ctl ping >/dev/null 2>&1; then
        [ -n "$cache" ] && touch "$cache" 2>/dev/null || true
        hasHelper="true"
    fi
fi

# Output JSON
printf '{'
[ -n "$NS" ] && printf '"hasNs":true,' || printf '"hasNs":false,'
jbool hasRgb "$hasRgb"; printf ','
jbool hasTurbo "$hasTurbo"; printf ','
jbool hasEnek5130 "$hasEnek5130"; printf ','
jbool hasHelper "$hasHelper"; printf ','
jbool helperInstalled "$helperInstalled"; printf ','
jstr profile "$profile"; printf ','
jstr profileChoices "$profileChoices"; printf ','
jnum cpuTemp "$cpuTemp"; printf ','
jnum fanCpu "$fanCpu"; printf ','
jnum fanGpu "$fanGpu"; printf ','
jstr fanHwmonPath "$fanHwmonPath"; printf ','
jstr fanSpeed "$fanSpeed"; printf ','
jnum battLimiter "$battLimiter"; printf ','
jnum usbCharging "$usbCharging"; printf ','
jnum backlightTimeout "$backlightTimeout"; printf ','
jnum batteryCalibration "$batteryCalibration"; printf ','
jnum bootAnimationSound "$bootAnimationSound"; printf ','
jnum lcdOverride "$lcdOverride"; printf ','
jstr fourZoneMode "$fourZoneMode"; printf ','
jstr perZoneMode "$perZoneMode"; printf ','
jnum turboState "$turboState"
printf '}\n'
